#!name=Claude 可选第三方依赖
#!desc=可选：将 Statsig / Sift / Sentry / Datadog 等共享服务转到 Claude 策略。会影响使用相同域名的其他应用，只有确有需要时才启用。
#!arguments=ClaudePolicy:Claude
#!arguments-desc=ClaudePolicy：与「Claude 专属分流」模块设置为同一个、实际存在的策略组或代理名称。

[Rule]
# 这些是其他应用也可能使用的共享域名，非 Claude 专有。
DOMAIN-SUFFIX,statsigapi.net,{{{ClaudePolicy}}}
DOMAIN-SUFFIX,statsig.com,{{{ClaudePolicy}}}
DOMAIN-SUFFIX,sift.com,{{{ClaudePolicy}}}
DOMAIN-SUFFIX,siftscience.com,{{{ClaudePolicy}}}
DOMAIN-SUFFIX,sentry.io,{{{ClaudePolicy}}}
DOMAIN,rum.browser-intake-datadoghq.com,{{{ClaudePolicy}}}
