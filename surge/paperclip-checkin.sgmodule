#!name=Paperclip · Surge 签到合集（中文参数）
#!desc=在模块编辑参数中：# 表示关闭，留空表示启用。默认全部关闭，按需开启。NodeSeek 已有独立模块，不重复添加。本模块不包含 MITM 或 Cookie 抓取。
#!author=MaYIHEI (原脚本), ChatGPT (Surge 转换)
#!homepage=https://github.com/MaYIHEI/paperclip
#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/paperclip-checkin.png
#!arguments=签到汇总:#,微博超话签到:#,腾讯视频签到:#,米游社签到:#,一点万象签到:#,小米商城签到:#,小米抽奖签到:#,有品签到:#,龙湖App签到:#,QQ音乐每日任务:#,QQ音乐定时金币:#,QQ音乐红包雨:#,万达电影签到:#,听听FM签到:#,WPS签到:#,扫描全能王签到:#,追觅签到:#,灵狐灵购签到:#,123社区签到:#,AgentRouter签到:#,网上国网签到:#,中国移动签到:#,小黑盒签到:#,百度网盘签到:#,徕芬签到:#,泡泡玛特签到:#,途虎养车签到:#,海底捞签到:#,惠省红包墙签到:#,名创优品签到:#,龙德广场签到:#,龙湖天街签到:#,味多美签到:#,北京华联签到:#,林里签到:#
#!arguments-desc=每个中文参数填写 # 表示禁用（该定时任务不注册）；清空该参数表示启用。默认全部关闭，按需开启；如安装了其他相同的签到模块请避免重复。签到汇总为单独开关。

[Script]
{{{签到汇总}}}签到汇总 = type=cron,cronexp="30 11 * * *",wake-system=true,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/summary/summary.js,timeout=180
{{{微博超话签到}}}微博超话签到 = type=cron,cronexp="0 8 * * *",wake-system=true,script-path=https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/weibotalk/weibotalk.js,timeout=180
